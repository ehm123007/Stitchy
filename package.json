  "description": "Aesthetic Pure Export Clothing E-Commerce Website & Admin Operations Platform",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"node server/server.js\" \"npm run dev --prefix client\"",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client || echo Using existing dist",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client"
