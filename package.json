    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0"
  }
